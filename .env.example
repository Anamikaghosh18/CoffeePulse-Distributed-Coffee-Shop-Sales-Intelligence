# CoffeePulse Environment Configuration Template
# Copy this file to .env and adjust variables as needed

# Application Environment
ENVIRONMENT=development
DEBUG=True

# Backend API Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Spark Local Cluster Configuration
SPARK_APP_NAME=CoffeePulseLocal
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_LOG_LEVEL=WARN

# Data & Artifact Directories (Relative to project root or absolute paths)
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_SAMPLE_FILE=./data/sample/sample_sales.csv
ARTIFACTS_MODELS_DIR=./artifacts/models
ARTIFACTS_CHECKPOINTS_DIR=./artifacts/checkpoints
